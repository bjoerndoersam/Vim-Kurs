    });
  }

  function makeWorkspace(ex, opts) {
    const Vim = root.Vim;
    opts = opts || {};
    const lines = (ex.files ? ex.files.map[ex.files.order[0]] : ex.text).split('\n').length;
    const height = ex.height || opts.height || Math.max(ex.files ? 8 : 4, Math.min(14, lines + 1));
    const wsOpts = { height };
