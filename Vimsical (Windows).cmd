    </div>`;
    const notesName = S.lang === 'en' ? 'playground.txt' : 'spielwiese.txt';
    const vimrc = typeof S.vimrc === 'string' ? S.vimrc : t('pg.vimrcDefault');
    let ws;
    const boot = text => {
