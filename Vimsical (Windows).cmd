      <section class="l-keys" aria-label="${esc(t('l.cmds'))}">${l.keys.map(k => `<div class="keycard"><kbd>${fmtKey(k[0])}</kbd><span>${esc(L(k[1]))}</span></div>`).join('')}</section>
      <div class="l-learn">
