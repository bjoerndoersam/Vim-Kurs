            { tier: 'basic', task: T('Kopiere die erste Zeile ans Ende.', 'Copy the first line to the end.'), text: T('¶Titel\nA\nB', '¶Title\nA\nB'), goal: T('Titel\nA\nB\nTitel', 'Title\nA\nB\nTitle'), sol: ':1t$<CR>' },
