  /* ---------- Arbeitsbereich: Fenster und Tabs ---------- */
  class Workspace {
    constructor(opts) {
      opts = opts || {};
      this.shared = makeShared(opts.o);
      this.shared.ws = this;
      this.rows = opts.height || 12;
      this.nextWin = 1;
      const files = opts.files || null;
      let first = null;
      if (files && Object.keys(files).length) {
