    const tip = L(l.tip), concept = L(l.concept);
    main.innerHTML = `<article class="page lesson">
      <header class="l-head">
        <p class="eyebrow">${t('l.eyebrow', l.ci + 1, esc(L(l.chapter.title)), l.num, LESSONS.length)}</p>
