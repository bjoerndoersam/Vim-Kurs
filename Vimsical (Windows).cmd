  const ARROWS = { '←': '', '→': '', '↑': '', '↓': '' };

  function L(x, lang) {
    if (x == null) return x;
    if (typeof x === 'function') return x(lang);
    if (typeof x === 'object' && !Array.isArray(x) && ('de' in x || 'en' in x)) return x[lang] != null ? x[lang] : x.de;
