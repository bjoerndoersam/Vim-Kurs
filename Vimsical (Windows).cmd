  /* ---------- Tastatur ---------- */
  const KB_DE = { '!': 'S+1', '"': 'S+2', '$': 'S+4', '%': 'S+5', '&': 'S+6', '/': 'S+7', '(': 'S+8', ')': 'S+9', '=': 'S+0', '?': 'S+ß', '*': 'S++', "'": 'S+#', ':': 'S+.', ';': 'S+,', '_': 'S+-', '>': 'S+<' };
  const KB = {
