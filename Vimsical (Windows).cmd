    'de-pc': Object.assign({}, KB_DE, { '{': 'R+7', '[': 'R+8', ']': 'R+9', '}': 'R+0', '\\': 'R+ß', '|': 'R+<', '@': 'R+Q', '~': 'R++', '^': 'D^', '`': 'DS+´' }),
